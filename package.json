{
  "name": "obix-driver-dom",
  "version": "0.5.0",
  "description": "The OBIX browser driver: mount / update / unmount with keyed DOM morphing and delegated events, plus the small binding helpers (bindText, bindAttr, …). No business logic, no VDOM, no router, no store. Zero runtime dependencies.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "obix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-driver-dom.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-driver-dom/issues"
  },
  "homepage": "https://github.com/obinexus/obix-driver-dom#readme",
  "devDependencies": {
    "obix-core-runtime": "0.5.0"
  }
}
